# Copia este archivo como .env y ajusta los valores. El .env NUNCA se sube a git.

# --- Servidor
PORT=3000
NODE_ENV=production

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Horas que dura una sesión antes de pedir login otra vez
SESSION_HOURS=12

# Pon true SOLO si la app se sirve por HTTPS (activa cookies seguras y HSTS)
HTTPS_ONLY=false
# Pon true si hay un proxy delante (Nginx, Caddy, Render, Railway...)
TRUST_PROXY=false

# --- Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aramo_personal
